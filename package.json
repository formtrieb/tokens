{
  "name": "@formtrieb/token-resolver",
  "version": "0.1.0",
  "description": "Tokens-Studio JSON → CSS variables, utility classes, SCSS mixins, and Figma↔CSS lookup map. Driven by a project-local config.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/formtrieb/token-resolver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formtrieb/token-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/formtrieb/token-resolver/issues"
  },
  "keywords": [
    "design-tokens",
    "tokens-studio",
    "style-dictionary",
    "css-variables",
    "design-system"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "default": "./dist/builders/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "formtrieb-tokens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx src/cli.ts",
    "build:tokens": "tsx src/cli/build-tokens.ts",
    "build:imports": "tsx src/cli/generate-css-imports.ts",
    "build:token-map": "tsx src/cli/generate-token-map.ts",
    "build:bundle": "tsx src/cli/bundle-css.ts",
    "build:package": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build:package && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf cssOutput"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "chokidar": "^5.0.0",
    "style-dictionary": "^5.4.0",
    "tsx": "^4.21.0"
  }
}
