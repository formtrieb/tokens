{
  "button": {
    "background": {
      "$type": "color",
      "$value": "{color.brand.primary}"
    },
    "background-hover": {
      "$type": "color",
      "$value": "{color.brand.hover}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.inverted.primary}"
    },
    "radius": {
      "$type": "borderRadius",
      "$value": "{radius.sm}"
    },
    "height": {
      "$type": "dimension",
      "$value": "{controls.height.medium}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{spacing.inset.m}"
    },
    "border": {
      "$type": "dimension",
      "$value": "{borderWidth.thin}"
    }
  }
}
