{
  "name": "@formtrieb/tokens-render",
  "version": "0.3.0",
  "description": "Renders a Tokens-Studio-shaped token system to CSS — variables per render table, utilities, imports, bundle, token map. Pure functions over the tokens-core tree; no file system.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formtrieb/tokens.git",
    "directory": "packages/render"
  },
  "homepage": "https://github.com/formtrieb/tokens/tree/main/packages/render#readme",
  "bugs": {
    "url": "https://github.com/formtrieb/tokens/issues"
  },
  "keywords": [
    "design-tokens",
    "tokens-studio",
    "css-variables",
    "design-system"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest",
    "prepublishOnly": "npm run build && vitest --run"
  },
  "dependencies": {
    "@formtrieb/tokens-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "change-case": "^5.4.4",
    "tinycolor2": "^1.6.0",
    "@types/tinycolor2": "^1.4.6",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
