{
  "letterSpacings": {
    "tight2": {
      "$type": "letterSpacing",
      "$value": "-3%"
    },
    "tight1": {
      "$type": "letterSpacing",
      "$value": "-1%"
    },
    "default": {
      "$type": "letterSpacing",
      "$value": "0%"
    },
    "wide1": {
      "$type": "letterSpacing",
      "$value": "2%"
    },
    "wide2": {
      "$type": "letterSpacing",
      "$value": "8%"
    }
  },
  "textCase": {
    "default": {
      "$type": "textCase",
      "$value": "none"
    },
    "upper": {
      "$type": "textCase",
      "$value": "uppercase"
    }
  },
  "textDecorations": {
    "default": {
      "$type": "textDecoration",
      "$value": "none"
    },
    "underline": {
      "$type": "textDecoration",
      "$value": "underline"
    }
  },
  "paragraphIndents": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    }
  },
  "fontFamilies": {
    "base": {
      "$type": "fontFamilies",
      "$value": "Inter"
    },
    "mono": {
      "$type": "fontFamilies",
      "$value": "JetBrains Mono"
    }
  },
  "fontWeights": {
    "regular": {
      "$type": "fontWeights",
      "$value": "regular"
    },
    "medium": {
      "$type": "fontWeights",
      "$value": "Medium"
    },
    "semibold": {
      "$type": "fontWeights",
      "$value": "SemiBold"
    },
    "bold": {
      "$type": "fontWeights",
      "$value": "bold"
    }
  },
  "Title": {
    "1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamilies.base}",
        "fontWeight": "{fontWeights.bold}",
        "lineHeight": "{lineHeights.title.1}",
        "fontSize": "{fontSizes.title.1}",
        "letterSpacing": "{letterSpacings.tight2}",
        "paragraphSpacing": "{paragraphSpacings.none}",
        "paragraphIndent": "{paragraphIndents.none}",
        "textCase": "{textCase.default}",
        "textDecoration": "{textDecorations.default}"
      }
