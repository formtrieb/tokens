  "cssOutput/css/utilities/_typography.scss": "/// Typography mixins — auto-generated.
/// Apply a typography token to any selector via @include.
///
/// Usage:
///   @include typography('display-1');
///   @include typography-paragraph('body-base-default');

@mixin typography($token) {
  font: var(--ds-#{$token});
  letter-spacing: var(--ds-#{$token}-letter-spacing);
  text-transform: var(--ds-#{$token}-text-transform);
  text-decoration: var(--ds-#{$token}-text-decoration);
  font-variant-numeric: var(--ds-#{$token}-fvn, normal);
}

@mixin typography-paragraph($token) {
  text-indent: var(--ds-#{$token}-text-indent);
  margin-block-end: var(--ds-#{$token}-margin-block-end);
}
