{
  "name": "@formtrieb/tokens-cli",
  "version": "0.7.0",
  "description": "Tokens-Studio JSON → CSS variables, utility classes, SCSS mixins and a Figma↔CSS lookup map, driven by a project-local config. The command line around @formtrieb/tokens-render.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/formtrieb/tokens/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formtrieb/tokens.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/formtrieb/tokens/issues"
  },
  "keywords": [
    "design-tokens",
    "tokens-studio",
    "css-variables",
    "design-system"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "default": "./dist/builders/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "formtrieb-tokens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsx src/cli.ts",
    "build:tokens": "tsx src/cli/build-tokens.ts",
    "build:imports": "tsx src/cli/generate-css-imports.ts",
    "build:token-map": "tsx src/cli/generate-token-map.ts",
    "build:bundle": "tsx src/cli/bundle-css.ts",
    "build:package": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build:package && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf cssOutput"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@formtrieb/tokens-core": "workspace:^",
    "@formtrieb/tokens-render": "workspace:^",
    "chokidar": "^5.0.0",
    "tsx": "^4.21.0"
  }
}
