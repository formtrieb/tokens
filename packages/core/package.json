{
  "name": "@formtrieb/tokens-core",
  "version": "2.1.0",
  "description": "Core library for Tokens-Studio-shaped design token systems — build a system from its files, compose themes, resolve references to typed values, colour functions and analysis. Pure functions, no I/O.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formtrieb/tokens.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/formtrieb/tokens/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/formtrieb/tokens/issues"
  },
  "keywords": [
    "design-tokens",
    "tokens-studio",
    "dtcg",
    "design-system",
    "theme",
    "token-resolution"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest",
    "prepublishOnly": "npm run build && vitest --run --passWithNoTests"
  },
  "dependencies": {
    "culori": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
